# Public canonical origin used for Next.js Metadata/OpenGraph URL resolution
NEXT_PUBLIC_SITE_URL=https://hoho.xo

# Optional: Custom local/container file store path (defaults to OS temp in dev and .data/hoho-store.json in production)
# HOHO_STORE_FILE=/app/.data/hoho-store.json

# Optional: Upstash Redis / Vercel KV REST credentials for durable serverless persistence across cold starts.
# Leave unset locally to use atomic file storage in .data/hoho-store.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative Vercel KV variable names (supported automatically if set):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
