# Public canonical origin used for Next.js Metadata/OpenGraph URL resolution
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional Google Search Console HTML verification meta token
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Required in production: secret salt for HMAC-SHA256 client IP hashing (rate limiting only)
HOHO_IP_SALT=

# Trusted reverse proxy mode for client IP extraction: vercel | cloudflare | none (default: none)
HOHO_TRUSTED_PROXY=none

# Optional: Fail startup/writes in production if Upstash KV is missing (set 1 on serverless)
# HOHO_REQUIRE_DURABLE=1

# Optional: Custom local/container file store path (defaults to OS temp in dev and .data/hoho-store.json in production)
# HOHO_STORE_FILE=/app/.data/hoho-store.json

# Optional: Upstash Redis / Vercel KV REST credentials for durable serverless persistence across cold starts.
# Required when deployed on Vercel; leave unset locally for atomic file storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative Vercel KV variable names (supported automatically if set):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional tuning limits
# HOHO_MAX_MESSAGES_PER_TREE=1000
# HOHO_GLOBAL_MSG_LIMIT=20
# HOHO_HANDLE_HOURLY_LIMIT=200

# Optional external safety moderation layer (off by default)
# HOHO_MODERATION_PROVIDER=openai
# OPENAI_API_KEY=

# Optional Web Push (VAPID) owner notifications ("Notify me" toggle)
# Generate keys with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@example.com

# Optional ethical owner tip links (Owner Studio only, omitted when unset)
# NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/yourhandle
# NEXT_PUBLIC_BUYMEACOFFEE_URL=https://buymeacoffee.com/yourhandle
# NEXT_PUBLIC_GITHUB_SPONSORS_URL=https://github.com/sponsors/yourhandle
# NEXT_PUBLIC_SUPPORT_TIP_NOTE=
# HOHO_SUPPORTER_CODES=
